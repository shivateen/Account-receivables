      "open_invoices": [ { "id": "INV1", "doc_number": "90012345", "customer_id": "CUST-1", "open_amount": 480000, "currency": "USD", "due_date": "2026-06-18" } ] },
    "expect": { "status": "matched", "matched": ["INV1"] } },

  { "name": "exact with leading zeros on ref",
